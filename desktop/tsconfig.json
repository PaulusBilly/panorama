{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../desktop-dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "shared/**/*.ts"]
}
