--- /dev/null
+++ b/video/out/vulkan/context_panorama.c
@@ -0,0 +1,115 @@
+#define VK_USE_PLATFORM_METAL_EXT
+#include "context.h"
+#include "utils.h"
+#include "options/options.h"
+#include "panorama_surface.h"
+
+struct priv {
+    struct mpvk_ctx vk;
+    struct panorama_surface *surface;
+    struct panorama_surface_state state;
+};
+
+static void uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+}
+
+static bool visible(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    return p->surface->snapshot(p->surface->opaque).visible;
+}
+
+static void swapped(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    p->surface->swapped(p->surface->opaque);
+}
+
+static pl_color_space_t preferred_csp(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    const double headroom = p->surface->snapshot(p->surface->opaque).headroom;
+    return (pl_color_space_t) {
+        .primaries = PL_COLOR_PRIM_BT_709,
+        .transfer = headroom > 1.0 ? PL_COLOR_TRC_LINEAR : PL_COLOR_TRC_SRGB,
+        .hdr.max_luma = PL_COLOR_SDR_WHITE * headroom,
+    };
+}
+
+static bool init(struct ra_ctx *ctx)
+{
+    if (ctx->opts.probing || ctx->vo->opts->WinID <= 0) return false;
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    p->surface = (struct panorama_surface *)(uintptr_t)ctx->vo->opts->WinID;
+    if (p->surface->version != 1 || !p->surface->layer || !p->surface->snapshot || !p->surface->swapped)
+        return false;
+    if (!mpvk_init(&p->vk, ctx, VK_EXT_METAL_SURFACE_EXTENSION_NAME)) return false;
+    VkMetalSurfaceCreateInfoEXT info = {
+        .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+        .pLayer = p->surface->layer,
+    };
+    if (vkCreateMetalSurfaceEXT(p->vk.vkinst->instance, &info, NULL, &p->vk.surface) != VK_SUCCESS) {
+        mpvk_uninit(&p->vk);
+        return false;
+    }
+    struct ra_ctx_params params = {
+        .check_visible = visible,
+        .swap_buffers = swapped,
+        .preferred_csp = preferred_csp,
+    };
+    if (!ra_vk_ctx_init(ctx, &p->vk, params, VK_PRESENT_MODE_FIFO_KHR)) {
+        mpvk_uninit(&p->vk);
+        return false;
+    }
+    p->state = p->surface->snapshot(p->surface->opaque);
+    return ra_vk_ctx_resize(ctx, MPMAX(1, p->state.width), MPMAX(1, p->state.height));
+}
+
+static bool reconfig(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    p->state = p->surface->snapshot(p->surface->opaque);
+    return ra_vk_ctx_resize(ctx, MPMAX(1, p->state.width), MPMAX(1, p->state.height));
+}
+
+static int control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    struct priv *p = ctx->priv;
+    struct panorama_surface_state state = p->surface->snapshot(p->surface->opaque);
+    if (request == VOCTRL_CHECK_EVENTS) {
+        if (state.generation != p->state.generation) {
+            p->state = state;
+            *events |= VO_EVENT_RESIZE | VO_EVENT_EXPOSE | VO_EVENT_WIN_STATE;
+            if (!ra_vk_ctx_resize(ctx, MPMAX(1, state.width), MPMAX(1, state.height))) return VO_ERROR;
+        }
+        return VO_TRUE;
+    }
+    if (request == VOCTRL_GET_DISPLAY_FPS) {
+        *(double *)arg = state.fps;
+        return state.fps > 0 ? VO_TRUE : VO_NOTIMPL;
+    }
+    if (request == VOCTRL_GET_HIDPI_SCALE) {
+        *(double *)arg = state.scale;
+        return VO_TRUE;
+    }
+    if (request == VOCTRL_GET_DISPLAY_RES) {
+        ((int *)arg)[0] = state.width;
+        ((int *)arg)[1] = state.height;
+        return VO_TRUE;
+    }
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_panorama = {
+    .type = "vulkan",
+    .name = "panorama-macvk",
+    .description = "Panorama embedded Metal surface",
+    .init = init,
+    .uninit = uninit,
+    .reconfig = reconfig,
+    .control = control,
+};
--- /dev/null
+++ b/video/out/vulkan/panorama_surface.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <stdint.h>
+
+struct panorama_surface_state {
+    int width;
+    int height;
+    int visible;
+    double fps;
+    double scale;
+    double headroom;
+    uint64_t generation;
+};
+
+struct panorama_surface {
+    uint64_t version;
+    void *layer;
+    void *opaque;
+    struct panorama_surface_state (*snapshot)(void *opaque);
+    void (*swapped)(void *opaque);
+};
